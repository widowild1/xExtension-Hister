#!/usr/bin/env python3
import argparse
import glob
import json
import os
import subprocess
import time

DEFAULT_DATA_DIR = os.getenv("FRESHRSS_DATA", "/opt/freshrss/data")


def get_worker_pids():
    try:
        out = subprocess.check_output(
            ["pgrep", "-f", r"drain_hister_queue\.py"], text=True, stderr=subprocess.DEVNULL
        ).strip()
        return out.splitlines() if out else []
    except subprocess.CalledProcessError:
        return []


def count_lines(data_dir, pattern):
    total = 0
    files = [
        f for f in glob.glob(os.path.join(data_dir, pattern))
        if not f.endswith((".lock", ".tmp"))
    ]
    for path in files:
        try:
            with open(path, "rb") as f:
                total += sum(1 for _ in f)
        except OSError:
            pass
    return total, len(files)


def render(data_dir):
    status_file = os.path.join(data_dir, "hister-drain-status.json")
    pids = get_worker_pids()
    running_proc = len(pids) > 0

    data = {}
    if os.path.isfile(status_file):
        try:
            with open(status_file, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception:
            pass

    processed = data.get("processed", 0)
    total = data.get("total", 0)
    pct = float(data.get("pct", 0.0))
    sent = data.get("sent", 0)
    conflict = data.get("conflict", 0)
    failed = data.get("failed", 0)
    dead = data.get("dead", 0)
    rate = data.get("rate", 0.0)
    eta = data.get("eta_min", 0.0)
    msg = data.get("message", "")

    queue_lines, queue_files = count_lines(data_dir, "hister-queue-*.jsonl*")
    dead_lines, _ = count_lines(data_dir, "hister-dead-*.jsonl")

    width = 30
    filled = int(width * min(100.0, max(0.0, pct)) / 100.0)
    bar = "█" * filled + "░" * (width - filled)

    state = f"ACTIF (PID {', '.join(pids)})" if running_proc else "ARRÊTÉ"
    lines = [
        f"=== Hister Queue Monitor ({time.strftime('%H:%M:%S')}) ===",
        f"Worker      : {state}",
        f"Progression : [{bar}] {pct:5.1f}% ({processed}/{total})",
        f"Détails     : +{sent} indexés | {conflict} vus (409) | {failed} retry | {dead} morts",
        f"Cadence     : {rate} art/s | Temps restant estimé : ~{eta} min",
        f"Disque      : {queue_lines} ligne(s) en file ({queue_files} fichier(s)) | {dead_lines} lien(s) mort(s) archivé(s)",
    ]
    if msg and not running_proc:
        lines.append(f"Bilan       : {msg}")
    return "\n".join(lines), running_proc


def main():
    parser = argparse.ArgumentParser(description="Suivi du dépilage Hister en CLI")
    parser.add_argument("-w", "--watch", action="store_true", help="Rafraîchir en continu toutes les 2s")
    parser.add_argument("-d", "--data-dir", default=DEFAULT_DATA_DIR, help="Répertoire data de FreshRSS")
    args = parser.parse_args()

    if not args.watch:
        output, _ = render(args.data_dir)
        print(output)
        return

    try:
        while True:
            output, is_running = render(args.data_dir)
            print("\033[2J\033[H" + output, flush=True)
            if not is_running:
                break
            time.sleep(2)
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
