        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="endpoint_path"><?php echo _t('ext.hister.endpoint_path'); ?></label>
        <div class="group-controls">
            <input type="text" id="endpoint_path" name="endpoint_path" class="input-text"
                   value="<?php echo htmlspecialchars((string)$this->getUserConfigurationValue('endpoint_path') ?: '/api/v1/bookmarks', ENT_QUOTES, 'UTF-8'); ?>"
                   placeholder="/api/v1/bookmarks" required />
            <p class="help"><?php echo _t('ext.hister.endpoint_path_help'); ?></p>
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="api_token"><?php echo _t('ext.hister.api_token'); ?></label>
        <div class="group-controls">
            <input type="password" id="api_token" name="api_token" class="input-text"
                   value="<?php echo htmlspecialchars((string)$this->getUserConfigurationValue('api_token'), ENT_QUOTES, 'UTF-8'); ?>"
                   placeholder="Bearer eyJhbGciOi..." required autocomplete="off" />
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="default_tags"><?php echo _t('ext.hister.default_tags'); ?></label>
        <div class="group-controls">
