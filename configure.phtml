<?php
declare(strict_types=1);
/** @var HisterExtension $this */
?>
<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
    <?php echo FreshRSS_Form_Token::html(); ?>

    <div class="form-group">
        <label class="group-name" for="api_url"><?php echo _t('ext.hister.api_url'); ?></label>
        <div class="group-controls">
            <input type="url" id="api_url" name="api_url" class="input-text"
                   value="<?php echo htmlspecialchars((string)$this->getUserConfigurationValue('api_url') ?: 'https://demo.hister.org', ENT_QUOTES, 'UTF-8'); ?>"
                   placeholder="https://demo.hister.org" required />
