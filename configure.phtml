        </div>
    </div>

    <div class="form-group">
        <div class="group-controls">
            <label class="checkbox" for="include_category_tag">
                <input type="checkbox" id="include_category_tag" name="include_category_tag" value="1"
                    <?php echo (bool)$this->getUserConfigurationValue('include_category_tag') ? 'checked="checked"' : ''; ?> />
                <?php echo _t('ext.hister.include_category_tag'); ?>
            </label>
        </div>
    </div>

    <div class="form-group">
        <div class="group-controls">
            <label class="checkbox" for="include_feed_tag">
                <input type="checkbox" id="include_feed_tag" name="include_feed_tag" value="1"
                    <?php echo (bool)$this->getUserConfigurationValue('include_feed_tag') ? 'checked="checked"' : ''; ?> />
                <?php echo _t('ext.hister.include_feed_tag'); ?>
            </label>
        </div>
    </div>

    <div class="form-group">
        <div class="group-controls">
            <label class="checkbox" for="auto_sync_all">
                <input type="checkbox" id="auto_sync_all" name="auto_sync_all" value="1"
                    <?php echo (bool)$this->getUserConfigurationValue('auto_sync_all') ? 'checked="checked"' : ''; ?> />
                <?php echo _t('ext.hister.auto_sync_all'); ?>
            </label>
        </div>
